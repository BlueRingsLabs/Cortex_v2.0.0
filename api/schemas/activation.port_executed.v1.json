{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cortex:webhook:activation.port_executed:v1",
  "title": "activation.port_executed",
  "description": "A number moved between carriers on its execution day. `direction` says which way; a port out is the moment retention has lost the line.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "timestamp",
    "schema_version",
    "data"
  ],
  "properties": {
    "type": {
      "const": "activation.port_executed"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact was published, in UTC."
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counterparty_code",
        "direction",
        "executed_on",
        "port_reference",
        "subject_id"
      ],
      "properties": {
        "counterparty_code": {
          "type": "string",
          "description": "The other carrier's code."
        },
        "direction": {
          "type": "string",
          "description": "in: the number arrived; out: it left for another carrier.",
          "enum": [
            "in",
            "out"
          ]
        },
        "executed_on": {
          "type": "string",
          "description": "The day the number moved.",
          "format": "date"
        },
        "port_reference": {
          "type": "string",
          "description": "The portability request's reference."
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The customer holding the line the port activated; null for a port with no order behind it, which names nobody.",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    }
  }
}
